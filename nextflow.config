manifest {
    name            = 'nxf-cifi'
    description     = 'hifiasm (HiFi + ONT UL) assembly, optional CiFi phasing + YaHS scaffolding, and evaluation'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
    version         = '1.0.0'
}

plugins {
    id 'nf-schema@2.5.1'           // --help, parameter validation, run summary (nextflow_schema.json)
}

params {
    // reads
    hifi             = null
    ont              = null
    ont_minlen       = 0
    map_ont          = false       // map ONT reads to hap1 / hap2 (BAM + coverage)
    assembly         = null        // existing hap1.fa[,hap2.fa]: skip hifiasm, run CiFi scaffolding + evaluation
    // CiFi
    cifi             = null
    enzyme           = 'HindIII'
    juicer_jar       = null
    contig_ec        = false
    cifi_mapq        = 0        // Dennis lab defaults
    cifi_min_seg     = 1
    cifi_min_seg_len = 20
    skip_pretext     = false
    cifi_stats_mapq      = 1          // contact analysis (as cifi contacts -q / the paper's MAPQ >= 1)
    cifi_stats_max_pairs = 20000000   // pairs analysed for P(s) and cis/trans; segment stats use all reads
    cifi_stats_min_scaf  = 1000000    // scaffolds >= this are chromosomes for cis/trans
    cifi_stats_bin       = 100000     // segment coverage bin
    skip_cifi_stats      = false
    cifi_rmdup           = false      // pbmarkdup --rmdup before digestion (default: only report the rate)
    skip_cifi_markdup    = false
    // hifiasm
    prefix           = 'asm'
    ploidy           = 2
    purge            = null
    hifiasm_args     = ''
    // evaluation
    lineage          = 'embryophyta'
    lineage_dir      = null
    kmer             = 21
    meryl_db         = null
    telo_motif_f     = 'TTTAGGG'   // Arabidopsis-type plant telomere (G-rich strand)
    telo_motif_r     = 'CCCTAAA'
    telo_window      = 10000       // bp examined at each sequence end
    telo_min         = 30          // >= 30 copies (~210 bp) in the window = telomere present
    report_subsample = 0.1         // fraction of reads for faster-report plots / k-mers
    skip_busco       = false
    skip_merqury     = false
    skip_reads_qc    = false
    // dot plots (minimap2)
    ref              = null        // optional reference: dot plot every assembly against it
    dotplot_preset   = 'asm5'
    dotplot_min_aln  = 10000       // ignore alignments shorter than this
    dotplot_min_seq  = 500000      // do not draw sequences shorter than this
    skip_dotplot     = false
    // general
    outdir           = 'asm_out'
    publish_mode     = 'copy'
    max_cpus         = 32
    max_memory       = '256 GB'
    monochrome_logs  = false
}

validation {
    monochromeLogs = params.monochrome_logs
    help {
        enabled    = true
        command    = 'nextflow run nxf-cifi --hifi hifi.bam --ont ont_ul.fastq.gz --cifi cifi.bam --enzyme HindIII --prefix myplant --outdir asm_CiFi'
        afterText  = '''
Without --cifi: HiFi + ONT UL assembly only. With --assembly hap1.fa[,hap2.fa] --cifi: CiFi scaffolding of an existing assembly.
Compare runs afterwards with bin/compare_assemblies.sh -d noCiFi=asm_noCiFi -d CiFi=asm_CiFi ...
Profiles: docker (default), singularity, slurm. Rerun with -resume to continue.'''
    }
}

process {
    shell          = ['/bin/bash', '-euo', 'pipefail']
    resourceLimits = [cpus: params.max_cpus as int, memory: new nextflow.util.MemoryUnit(params.max_memory.toString())]
    cpus           = 1
    memory         = '4 GB'

    withLabel: mid     { cpus = 8;  memory = '16 GB' }
    withLabel: big     { cpus = 16; memory = '64 GB' }
    withLabel: hifiasm { cpus = { params.max_cpus as int }; memory = { params.max_memory } }

    // ------------------------------------------------------------- containers (all processes)
    withName: 'BAM2FASTQ|CIFI_BAM' {
        container = 'quay.io/biocontainers/samtools:1.21--h96c455f_1'
    }
    withName: 'ONT_FILTER|GFA2FASTA|ASM_IMPORT' {
        container = 'quay.io/biocontainers/seqkit:2.10.1--he881be0_0'
    }
    withName: 'FASTER_REPORT' {
        container = 'docker.io/aangeloo/faster-report:latest'   // github.com/angelovangel/faster-report
    }
    withName: 'CIFI_QC|CIFI_DIGEST|CIFI_CONTACTS' {
        container = 'quay.io/biocontainers/cifi:1.1.0--py312h0c6b66a_0'
    }
    withName: 'CIFI_MARKDUP' {
        container = 'quay.io/biocontainers/pbmarkdup:1.2.0--h9ee0642_0'
    }
    withName: 'HIFIASM' {
        container = 'quay.io/biocontainers/hifiasm:0.25.0--h5ca1c30_0'
    }
    withName: 'MAP_SEGMENTS|DOTPLOT_ALIGN|MAP_ONT' {
        container = 'community.wave.seqera.io/library/minimap2_samtools_procps-ng:a6a2be08b29bce9f'
    }
    withName: 'YAHS' {
        container = 'quay.io/biocontainers/yahs:1.2.2--h577a1d6_1'              // provides juicer
    }
    withName: 'JUICER_TOOLS' {
        container = 'docker.io/library/eclipse-temurin:21-jre'
    }
    withName: 'PRETEXTMAP' {
        container = 'quay.io/biocontainers/pretextmap:0.2.4--hd63eeec_0'
    }
    withName: 'PRETEXTSNAPSHOT' {
        container = 'quay.io/biocontainers/pretextsnapshot:0.1.1--hc52dbad_0'
    }
    withName: 'ASM_STATS|SUMMARY|DOTPLOT|REPORT|CIFI_STATS' {
        container = 'community.wave.seqera.io/library/python_matplotlib_procps-ng:e896924bb279b00c'
    }
    withName: 'COMPLEASM_DOWNLOAD|COMPLEASM' {
        container = 'quay.io/biocontainers/compleasm:0.2.9--pyhdfd78af_0'
    }
    withName: 'MERYL_COUNT|MERQURY' {
        container = 'quay.io/biocontainers/merqury:1.3--hdfd78af_4'
    }
}

// docker is the default
docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g) -e HOME=/tmp'
}

profiles {
    docker {
        docker.enabled      = true
        singularity.enabled = false
    }
    singularity {
        docker.enabled         = false
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${System.getenv('HOME')}/.singularity-cache"
    }
    slurm {
        process.executor   = 'slurm'
        executor.queueSize = 50
    }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.tsv" }
